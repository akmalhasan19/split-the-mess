# Split The Mess — contoh env (JANGAN isi secret asli di file ini)
# Copy ke .env.local lalu isi dari Supabase Dashboard → Project Settings → API,
# atau dari Connect dialog (Supabase format baru: sb_publishable_... / sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# Legacy name, isi dengan "Publishable" key (sb_publishable_...):
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ganti_dengan_milikmu
# Hanya dipakai di server (API routes). Isi dengan "Secret" key (sb_secret_...):
SUPABASE_SERVICE_ROLE_KEY=sb_secret_ganti_dengan_milikmu

# Dipakai Fase 4+ (bot WhatsApp). Biarkan begini untuk Fase 0.
WA_PROVIDER=baileys
APP_BASE_URL=http://localhost:3000

